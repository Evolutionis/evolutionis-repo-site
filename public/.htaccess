# Endereço oficial: https://evolutionis.com.br (sem www).
# O Google já indexou esta versão; www e http redirecionam (301) para ela, senão
# os dois endereços viram conteúdo duplicado dividindo a força no Google.
# Depende de a Locaweb respeitar .htaccess — conferir com curl -I após o deploy.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\. [NC,OR]
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://evolutionis.com.br%{REQUEST_URI} [L,R=301]
</IfModule>

# Cabeçalhos de segurança — achado M4.
#
# Este arquivo fica em public/, então o Vite o copia para dist/ no build e ele
# sobe junto no deploy por FTP. Aqui estão só os cabeçalhos que uma meta tag
# NÃO consegue declarar; a Content-Security-Policy propriamente dita está no
# index.html, porque não depende do servidor respeitar .htaccess.
#
# ATENÇÃO — isto precisa ser conferido depois do primeiro deploy:
# a Locaweb pode ignorar .htaccess conforme o plano de hospedagem (exige
# AllowOverride habilitado). Abra o site publicado, aba Network > Headers, e
# confirme que os três cabeçalhos abaixo aparecem na resposta do documento. Se
# não aparecerem, o servidor está descartando este arquivo — nesse caso a
# proteção real é só a do index.html, e a limitação deve ser registrada em vez
# de ser dada como resolvida.

<IfModule mod_headers.c>
  # Impede o navegador de adivinhar o tipo do conteúdo. Sem isso, um arquivo
  # servido com o tipo errado pode acabar interpretado como HTML ou script.
  Header always set X-Content-Type-Options "nosniff"

  # Só funciona como cabeçalho HTTP: frame-ancestors não existe em meta tag, e
  # X-Frame-Options em meta é ignorado por todos os navegadores.
  # SAMEORIGIN, e não DENY, porque um painel de pré-visualização do CMS pode
  # precisar exibir o site num quadro. Se ficar confirmado que ninguém embute o
  # site, DENY é a opção mais fechada.
  Header always set X-Frame-Options "SAMEORIGIN"

  # HSTS: 6 meses, sem includeSubDomains e sem preload de propósito.
  # includeSubDomains passa a valer para TODOS os subdomínios do domínio, e
  # derruba qualquer um que ainda não tenha HTTPS; preload é praticamente
  # irreversível. Suba para 31536000 e acrescente includeSubDomains depois de
  # confirmar que todo subdomínio serve HTTPS.
  #
  # env=HTTPS restringe o cabeçalho às respostas servidas sobre TLS, como manda
  # a especificação. É a forma consagrada da diretiva — condicionar por
  # "expr=..." aqui é fácil de escrever errado e derruba o site com 500.
  Header always set Strict-Transport-Security "max-age=15768000" env=HTTPS
</IfModule>

# Cache e compressão — PageSpeed de 22/11/2026 ("ciclos de vida de cache" e
# "latência da solicitação de documentos").
#
# A regra de ouro: só o que tem hash no nome pode ficar em cache por muito
# tempo. Arquivo com nome fixo (HTML, sw.js, content.json) precisa revalidar a
# cada visita, senão o visitante fica preso numa versão antiga — e o sw.js em
# cache longo impediria qualquer atualização do site de chegar.
<IfModule mod_headers.c>
  # Padrão: revalida sempre (HTML, sw.js, content.json, manifest, robots, sitemap).
  Header set Cache-Control "no-cache"

  # Gerados pelo Vite com hash no nome (ex.: index-DicxVvWU.js): o nome muda a
  # cada mudança de conteúdo, então podem ficar 1 ano sem revalidar.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Imagens e vídeo têm nome fixo e podem ser trocados pelo painel: 7 dias é o
  # meio-termo entre não baixar de novo a cada visita e não ficar preso numa
  # versão antiga por muito tempo.
  <FilesMatch "\.(png|jpe?g|webp|svg|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# Compressão do que é texto. Vídeo e imagens ficam de fora de propósito: já são
# comprimidos, e comprimir o vídeo quebraria as requisições de intervalo (Range)
# de que a rolagem do vídeo depende.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json application/manifest+json application/xml image/svg+xml
</IfModule>
